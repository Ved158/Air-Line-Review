    <worksheet name='Sheet 4'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Cancellation Reason&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Airline_Reviews (2)' name='federated.0dxe4pg0w225571di3pll0gfjhl2' />
          </datasources>
          <datasource-dependencies datasource='federated.0dxe4pg0w225571di3pll0gfjhl2'>
            <column caption='Cancellation Reason' datatype='string' name='[Calculation_0888464956346372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([Review]), &quot;weather&quot;)&#13;&#10;THEN &quot;Weather&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Review]), &quot;technical&quot;)&#13;&#10;OR CONTAINS(LOWER([Review]), &quot;mechanical&quot;)&#13;&#10;THEN &quot;Technical Issue&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Review]), &quot;overbook&quot;)&#13;&#10;THEN &quot;Overbooking&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Review]), &quot;strike&quot;)&#13;&#10;OR CONTAINS(LOWER([Review]), &quot;staff&quot;)&#13;&#10;THEN &quot;Staff/Strike&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Review]), &quot;cancel&quot;)&#13;&#10;OR CONTAINS(LOWER([Review]), &quot;refund&quot;)&#13;&#10;THEN &quot;Other Cancellation&quot;&#13;&#10;ELSE &quot;No Cancellation&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Review]' role='dimension' type='nominal' />
            <column caption='Airline_Reviews.csv' datatype='table' name='[__tableau_internal_object_id__].[Airline_Reviews.csv_37309331DA19447FB0DC0E2B31B82AB9]' role='measure' type='quantitative' />
            <column-instance column='[__tableau_internal_object_id__].[Airline_Reviews.csv_37309331DA19447FB0DC0E2B31B82AB9]' derivation='Count' name='[__tableau_internal_object_id__].[cnt:Airline_Reviews.csv_37309331DA19447FB0DC0E2B31B82AB9:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0888464956346372]' derivation='None' name='[none:Calculation_0888464956346372:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0dxe4pg0w225571di3pll0gfjhl2].[none:Calculation_0888464956346372:nk]'>
