      <column datatype='real' name='[Cabin Staff Service]' role='measure' type='quantitative' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[Airline_Reviews.csv_37309331DA19447FB0DC0E2B31B82AB9]) / TOTAL(COUNT([__tableau_internal_object_id__].[Airline_Reviews.csv_37309331DA19447FB0DC0E2B31B82AB9]))'>
          <table-calc ordering-field='[federated.0dxe4pg0w225571di3pll0gfjhl2].[none:Recommended:nk]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='“Cancellation Issues Reported by Customers”' datatype='string' name='[Calculation_0888464941395968]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER(STR(IFNULL([Review], &quot;&quot;))), &quot;cancel&quot;)&#13;&#10;OR CONTAINS(LOWER(STR(IFNULL([Review], &quot;&quot;))), &quot;refund&quot;)&#13;&#10;THEN &quot;Cancellation Mentioned&quot;&#13;&#10;ELSE &quot;No Cancellation&quot;&#13;&#10;END' />
      </column>
      <column caption='Delay mentioned' datatype='string' name='[Calculation_0888464948330497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER(STR(IFNULL([Review], &quot;&quot;))), &quot;delay&quot;)&#13;&#10;OR CONTAINS(LOWER(STR(IFNULL([Review], &quot;&quot;))), &quot;delayed&quot;)&#13;&#10;OR CONTAINS(LOWER(STR(IFNULL([Review], &quot;&quot;))), &quot;late&quot;)&#13;&#10;THEN &quot;Delay Mentioned&quot;&#13;&#10;ELSE &quot;No Delay&quot;&#13;&#10;END' />
      </column>
      <column caption='Cancellation Reason' datatype='string' name='[Calculation_0888464956346372]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Review]), &quot;weather&quot;)&#13;&#10;THEN &quot;Weather&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Review]), &quot;technical&quot;)&#13;&#10;OR CONTAINS(LOWER([Review]), &quot;mechanical&quot;)&#13;&#10;THEN &quot;Technical Issue&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Review]), &quot;overbook&quot;)&#13;&#10;THEN &quot;Overbooking&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Review]), &quot;strike&quot;)&#13;&#10;OR CONTAINS(LOWER([Review]), &quot;staff&quot;)&#13;&#10;THEN &quot;Staff/Strike&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Review]), &quot;cancel&quot;)&#13;&#10;OR CONTAINS(LOWER([Review]), &quot;refund&quot;)&#13;&#10;THEN &quot;Other Cancellation&quot;&#13;&#10;ELSE &quot;No Cancellation&quot;&#13;&#10;END' />
      </column>
